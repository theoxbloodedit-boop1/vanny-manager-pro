{
  "name": "vanny-manager-pro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "VANNY MANAGER PRO \u2014 African multi-business management SaaS.",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --dir tests/unit",
    "test:integration": "vitest run --dir tests/integration",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "pwa:guard": "node scripts/verify-sw.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm pwa:guard"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.1",
    "@serwist/next": "9.5.15",
    "@tanstack/react-query": "5.108.4",
    "better-auth": "1.7.27",
    "dexie": "4.4.7",
    "drizzle-orm": "0.45.4",
    "lucide-react": "0.545.0",
    "next": "16.4.6",
    "next-intl": "4.16.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "serwist": "9.5.15",
    "uuid": "13.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "19.0.0-beta.20",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/linux-x64"
    ]
  }
}
