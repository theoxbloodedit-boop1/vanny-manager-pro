# ---------------------------------------------------------------------------
# VANNY MANAGER PRO — environment template
#
# KEYS ONLY. NEVER put a real value in this file.
# Copy to .env.local and fill in locally. .env.local is gitignored.
#
# CI enforces this: a non-empty value on any line fails the build.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Neon pooled connection (PgBouncer). Used at runtime by serverless functions.
DATABASE_URL=

# Neon direct connection (no pooler). Used ONLY for migrations and drizzle-kit.
DIRECT_URL=

# Optional pool tuning for the tenant pool (src/db/tenant.ts). Safe defaults
# are built in; uncomment and set only if profiling shows a need.
# DATABASE_POOL_MAX=
# DATABASE_IDLE_MS=
# DATABASE_CONNECT_MS=

# --- Auth -------------------------------------------------------------------
# 32+ byte random value. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Must exactly match the deployed origin, e.g. https://app.vannymanager.com
# (used outside Vercel; on Vercel, VERCEL_URL wins by precedence)
BETTER_AUTH_URL=

# ADR-0016 follow-up: the stable PRODUCTION domain (an alias of every
# deployment). Added to Better Auth's trusted origins so browser sign-in from
# the production domain is not rejected with "Invalid origin". Set in Vercel
# env for production, e.g. https://vanny-manager-pro.vercel.app
APP_PRODUCTION_URL=

# Connection the Better Auth instance uses to own the identity tables
# (user/session/account/verification/organization/member/invitation).
# This is the SCHEMA-OWNER role (bypasses RLS by ownership). Falls back to
# DATABASE_URL when unset. On Neon this is typically the direct (non-pooled)
# role that applied the migrations.
AUTH_DATABASE_URL=

# --- Email transport (ADR-0013/0014) ----------------------------------------
# How verification/reset emails are delivered. Keys only — no credentials here.
#   none    = (default) email delivery DISABLED. App runs without Resend;
#             verification via manual approval, recovery via assisted recovery.
#   resend  = deliver via the Resend API (set RESEND_API_KEY + RESEND_FROM).
#             Enabled later by configuration only — no code change.
#   capture = in-memory outbox (tests).
#   (The former "log" transport was REMOVED; "smtp" is not supported.)
MAIL_TRANSPORT=

# --- Resend (only used when MAIL_TRANSPORT=resend) --------------------------
# RESEND_API_KEY=
# RESEND_FROM=
# Optional: max ms for the Resend HTTP call (default 5000).
# RESEND_TIMEOUT_MS=

# --- Manual approval (ADR-0014) ---------------------------------------------
# Trusted HS256 secret used to VERIFY the platform-operator token
# (scripts/manual-approval.mts). Never hard-coded, never logged. The operator
# identity comes from a token signed with this secret — never a typed argument.
# OPERATOR_TOKEN_SECRET=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
# local | preview | production
NEXT_PUBLIC_APP_ENV=

# Injected at build time from the git SHA. Do not set by hand.
APP_VERSION=

# --- Storage (Phase 4) ------------------------------------------------------
# Vercel Blob, receipt images only.
BLOB_READ_WRITE_TOKEN=

# --- Email (Phase 4) --------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=

# --- Scheduled jobs ---------------------------------------------------------
CRON_SECRET=

# --- Error tracking (Phase 6) ----------------------------------------------
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- CI only ----------------------------------------------------------------
# NEON_PROJECT_ID=
# NEON_API_KEY=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
