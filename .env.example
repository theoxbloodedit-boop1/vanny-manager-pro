# ---------------------------------------------------------------------------
# VANNY MANAGER PRO — environment template
#
# KEYS ONLY. NEVER put a real value in this file.
# Copy to .env.local and fill in locally. .env.local is gitignored.
#
# CI enforces this: a non-empty value on any line fails the build.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Neon pooled connection (PgBouncer). Used at runtime by serverless functions.
DATABASE_URL=

# Neon direct connection (no pooler). Used ONLY for migrations and drizzle-kit.
DIRECT_URL=

# --- Auth -------------------------------------------------------------------
# 32+ byte random value. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Must exactly match the deployed origin, e.g. https://app.vannymanager.com
BETTER_AUTH_URL=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=
# local | preview | production
NEXT_PUBLIC_APP_ENV=

# Injected at build time from the git SHA. Do not set by hand.
APP_VERSION=

# --- Storage (Phase 4) ------------------------------------------------------
# Vercel Blob, receipt images only.
BLOB_READ_WRITE_TOKEN=

# --- Email (Phase 4) --------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM=

# --- Scheduled jobs ---------------------------------------------------------
CRON_SECRET=

# --- Error tracking (Phase 6) ----------------------------------------------
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- CI only ----------------------------------------------------------------
# NEON_PROJECT_ID=
# NEON_API_KEY=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
